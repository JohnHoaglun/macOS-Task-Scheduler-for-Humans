{
  "schema_version": 2,
  "id": "9f8a6c0e-1111-4222-8333-444455556666",
  "name": "Python Weekdays",
  "label": "io.github.macos-task-scheduler.user.python-weekdays",
  "enabled": true,
  "command": {
    "type": "python",
    "interpreter": "/Users/example/project/.venv/bin/python",
    "script": "/Users/example/project/report.py",
    "arguments": []
  },
  "schedule": {
    "kind": "calendar",
    "times": [
      "07:30"
    ],
    "weekdays": [
      "friday",
      "monday",
      "wednesday"
    ],
    "run_at_load": false
  },
  "environment": {
    "variables": {
      "FOO": "bar"
    }
  },
  "working_directory": "/Users/example/project",
  "logging": {
    "stdout_path": "/Users/example/logs/report.stdout.log"
  }
}
