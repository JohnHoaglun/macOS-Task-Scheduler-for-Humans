{
  "schema_version": 1,
  "id": "9f8a6c0e-1111-4222-8333-444455556666",
  "name": "Shell MWF",
  "label": "io.github.macos-task-scheduler.user.shell-mwf",
  "enabled": true,
  "command": {
    "type": "shell",
    "executable": "/bin/zsh",
    "arguments": [
