{
  "schema_version": 1,
  "id": "9f8a6c0e-1111-4222-8333-444455556666",
  "name": "Executable Weekend",
  "label": "io.github.macos-task-scheduler.user.executable-weekend",
  "enabled": true,
  "command": {
    "type": "executable",
    "executable": "/opt/homebrew/bin/sync-tool",
    "arguments": [
      "--sync"
    ]
  },
  "schedule": {
    "time": "10:00",
    "weekdays": [
      "saturday",
      "sunday"
    ]
  },
  "environment": {
    "variables": {}
  },
  "logging": {}
}
